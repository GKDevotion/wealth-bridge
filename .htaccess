RewriteRule ^wealth-management wealth-management.php?slug=$1 [L,QSA]
RewriteRule ^child-education child-education.php?slug=$1 [L,QSA]

#Our Service > Insurance & Investment
RewriteRule ^life-insurance life-insurance.php?slug=$1 [L,QSA]
RewriteRule ^health-insurance health-insurance.php?slug=$1 [L,QSA]
RewriteRule ^tax-efficient-investment tax-efficient-investment.php?slug=$1 [L,QSA]
